# Copy to .env and fill in. Load with: source .env
export RUNPOD_API_KEY=        # https://www.runpod.io/console/user/settings
export KAGGLE_USERNAME=       # kaggle.com -> Settings -> API -> Create New Token
export KAGGLE_KEY=
export OPENROUTER_API_KEY=    # https://openrouter.ai/settings/keys
export OPENROUTER_MODEL=openai/gpt-4o-mini   # any OpenRouter model id
export OPENROUTER_JUDGE_MODEL=               # optional, defaults to OPENROUTER_MODEL
